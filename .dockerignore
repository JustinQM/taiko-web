# The image is built from the working tree, not a git clone, so keep
# history, editor state and local runtime data out of the build context.
.git
.jj
.direnv
.github
.gitattributes
.dockerignore

# Local dev and deployment scaffolding, not needed inside the image.
docker-compose*.yml
REFACTOR-PLAN.md
*.archive
*.dump
__pycache__
*.pyc
.venv

# Runtime data. Songs are a bind mount, config is mounted or copied in by
# the private layer, and version.json is generated by build.sh and copied
# explicitly so the build does not need .git.
public/songs
public/api
public/index.html
public/assets/song_skins
config.py
taiko.db
