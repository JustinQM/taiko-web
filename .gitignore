# ---- deployment and local dev ----
# jj snapshots the working copy on every command, so generated files are
# ignored here before anything creates them.
.direnv/
result
result-*
.env
docker-compose.override.yml
*.archive
*.dump
__pycache__/
# runtime plugin drop directory. The three plugins we used are settings
# now and the loader is inert, but upstream ignores public/src/js/plugin
# and this is its sibling.
public/src/plugins/
# generated from public/assets/fonts/TnT.ttf at image build time, so that
# no font binary is committed
highscores/static/tnt.woff2

# editor and test-run leavings
.session.vim
.pytest_cache/
